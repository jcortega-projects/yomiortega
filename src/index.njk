---
layout: base.njk
title: "Yomi Ortega · China Strategy for Latin America"
description: "Formo a equipos latinoamericanos para cerrar la brecha cultural que frena los negocios con China."
---

<!-- ========================= HERO ========================= -->
<section class="hero" id="home">
  <div class="hero__map">{% include "worldmap.svg" %}</div>
  <div class="frame"><i class="tl"></i><i class="tr"></i><i class="bl"></i><i class="br"></i></div>
  <div class="hero__inner">
    <p class="eyebrow hero__eyebrow">{{ home.hero.eyebrow }}</p>
    <h1>{{ home.hero.titulo | rico | safe }}</h1>
    <p class="hero__lead">{{ home.hero.lead }}</p>
    <div class="hero__cta">
      <a href="mailto:{{ site.email }}?subject=Consulta%20inicial" class="btn btn--solid">{{ home.hero.cta_primario }}</a>
      <a href="#temas" class="btn btn--ghost">{{ home.hero.cta_secundario }}</a>
    </div>
    <p class="hero__for">{{ home.hero.nota | rico | safe }}</p>
  </div>
</section>

<!-- ========================= PROBLEMA / PARA QUIÉN ========================= -->
<section class="section section--alt">
  <div class="wrap problem__inner">
    <p class="eyebrow">{{ home.problema.eyebrow }}</p>
    <h2>{{ home.problema.titulo }}</h2>
    <p>{{ home.problema.parrafo | rico | safe }}</p>
    <div class="forwho">
      <div><h3 class="_is">{{ home.problema.para_ti_titulo }}</h3><p>{{ home.problema.para_ti_texto }}</p></div>
      <div><h3>{{ home.problema.no_para_ti_titulo }}</h3><p>{{ home.problema.no_para_ti_texto }}</p></div>
    </div>
  </div>
</section>

<!-- ========================= SOBRE MÍ ========================= -->
<section class="section" id="sobre-mi">
  <div class="wrap about__grid">
    <figure class="portrait">
      <img src="{{ home.sobre_mi.foto }}" alt="Yomi Ortega" />
    </figure>
    <div class="about__body">
      <p class="eyebrow">{{ home.sobre_mi.eyebrow }}</p>
      <h2 class="gold">{{ home.sobre_mi.nombre }}</h2>
      {%- for p in home.sobre_mi.parrafos %}
      <p>{{ p }}</p>
      {%- endfor %}
      <ul class="facts">
        {%- for d in home.sobre_mi.datos %}
        <li><span class="k gold">{{ d.hanzi }}</span> {{ d.texto }}</li>
        {%- endfor %}
      </ul>
    </div>
  </div>
</section>

<!-- ========================= TEMAS ========================= -->
<section class="section section--alt" id="temas">
  <div class="wrap">
    <div class="section__head"><p class="eyebrow">{{ home.temas.eyebrow }}</p><h2>{{ home.temas.titulo }}</h2></div>
    <div class="blocks">
      {%- for b in home.temas.bloques %}
      <article class="block"><div class="block__num gold">{{ b.numero }}</div><div class="block__body"><h3>{{ b.titulo }}</h3><ul class="block__topics">{%- for t in b.temas %}<li>{{ t }}</li>{%- endfor %}</ul></div><div class="block__hanzi gold" aria-hidden="true">{{ b.hanzi }}</div></article>
      {%- endfor %}
    </div>
  </div>
</section>

<!-- ========================= BLOG ========================= -->
<section class="section" id="blog">
  <div class="wrap">
    <div class="section__head"><p class="eyebrow">{{ home.blog.eyebrow }}</p><h2>{{ home.blog.titulo }}</h2></div>
    <div class="posts">
      {%- for post in collections.blog | reverse -%}
      <article class="post">
        <span class="post__cat">{{ post.data.categoria }}</span>
        <h3>{{ post.data.title }}</h3>
        <p>{{ post.data.resumen }}</p>
        <a class="post__more" href="{{ post.url }}">Leer artículo →</a>
      </article>
      {%- endfor -%}
    </div>
  </div>
</section>

<!-- ========================= SERVICIOS ========================= -->
<section class="section section--alt" id="servicios">
  <div class="wrap">
    <div class="section__head"><p class="eyebrow">{{ home.servicios.eyebrow }}</p><h2>{{ home.servicios.titulo }}</h2></div>
    <div class="tiers">
      {%- for t in home.servicios.tiers %}
      <div class="tier"><span class="tier__step gold">{{ t.paso }}</span><h3>{{ t.titulo }}</h3><p>{{ t.descripcion }}</p><a class="tier__cta" href="#contacto">{{ t.cta }}</a></div>
      {%- endfor %}
    </div>
  </div>
</section>

<!-- ========================= LEAD MAGNET ========================= -->
<section class="section magnet">
  <div class="wrap">
    <p class="eyebrow">{{ home.magnet.eyebrow }}</p>
    <h2 class="gold">{{ home.magnet.titulo }}</h2>
    <p>{{ home.magnet.parrafo }}</p>
    <form class="magnet__form" name="guia" method="POST" data-netlify="true">
      <input type="email" name="email" placeholder="tu@correo.com" aria-label="Correo electrónico" required />
      <button class="btn btn--solid" type="submit">{{ home.magnet.boton }}</button>
    </form>
  </div>
</section>

<!-- ========================= CONTACTO ========================= -->
<section class="section section--alt" id="contacto">
  <div class="wrap contact__grid">
    <div>
      <p class="eyebrow">{{ home.contacto.eyebrow }}</p>
      <h2>{{ home.contacto.titulo }}</h2>
      <p>{{ home.contacto.parrafo }}</p>
      <a href="mailto:{{ site.email }}?subject=Consulta%20inicial" class="btn btn--solid">{{ home.contacto.boton }}</a>
    </div>
    <div class="contact__links">
      <a href="mailto:{{ site.email }}"><svg class="ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>{{ site.email }}</a>
      <a href="{{ site.whatsapp }}"><svg class="ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.4L3 21l2.1-5.4A8.5 8.5 0 1 1 21 11.5z"/></svg>+593 998 719 590</a>
      <a href="{{ site.linkedin }}"><svg class="ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 10v7M7 7v.01M11 17v-4a2 2 0 0 1 4 0v4M11 17v-7"/></svg>LinkedIn · Yomi Ortega</a>
      <a href="{{ site.instagram }}"><svg class="ic" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5v.01"/></svg>@yomiortega.co</a>
    </div>
  </div>
</section>
